    <worksheet name='Selected Market Snapshot'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Selected Market Growth Snapshot</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>2024 year-over-year housing and rental market performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro_Crosswalk' name='federated.1c7wlch1v6oos31410mw60y3qzn3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metro Area' datatype='string' name='[Parameter 2171313635725320]' param-domain-type='list' role='measure' type='nominal' value='&quot;York, PA&quot;'>
              <calculation class='tableau' formula='&quot;York, PA&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c7wlch1v6oos31410mw60y3qzn3'>
            <column caption='Metro Parameter Filter' datatype='boolean' name='[Calculation_2171313636048905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Zillow Metro] = [Parameters].[Parameter 2171313635725320]' />
            </column>
            <column caption='2024 Home Value Growth' datatype='real' default-format='p0.0%' name='[Calculation_2171313648156682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date]) = 2024&#13;&#10;        AND MONTH([Date]) = 12&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date]) = 2023&#13;&#10;        AND MONTH([Date]) = 12&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;) - 1' />
            </column>
            <column caption='2024 Rent Growth' datatype='real' default-format='p0.0%' name='[Calculation_2171313648758795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date (ZORI!Clean)]) = 2024&#13;&#10;        AND MONTH([Date (ZORI!Clean)]) = 12&#13;&#10;        THEN [Rent]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date (ZORI!Clean)]) = 2023&#13;&#10;        AND MONTH([Date (ZORI!Clean)]) = 12&#13;&#10;        THEN [Rent]&#13;&#10;        END&#13;&#10;    )&#13;&#10;) - 1' />
            </column>
            <column caption='Investment Growth Score' datatype='real' default-format='p0.0%' name='[Calculation_2171313651093517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2171313648156682] + [Calculation_2171313648758795]) / 2' />
            </column>
            <column caption='Rent Date' datatype='date' name='[Date (ZORI!Clean)]' role='dimension' type='ordinal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Home Value]' role='measure' type='quantitative' />
            <column datatype='real' name='[Rent]' role='measure' type='quantitative' />
            <column datatype='string' name='[Zillow Metro]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2171313636048905]' derivation='None' name='[none:Calculation_2171313636048905:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2171313648156682]' derivation='User' name='[usr:Calculation_2171313648156682:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2171313648758795]' derivation='User' name='[usr:Calculation_2171313648758795:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2171313651093517]' derivation='User' name='[usr:Calculation_2171313651093517:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1c7wlch1v6oos31410mw60y3qzn3].[:Measure Names]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1c7wlch1v6oos31410mw60y3qzn3].[usr:Calculation_2171313648156682:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1c7wlch1v6oos31410mw60y3qzn3].[usr:Calculation_2171313648758795:qk]&quot;' />
