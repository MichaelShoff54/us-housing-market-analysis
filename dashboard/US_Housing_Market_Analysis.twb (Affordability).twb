            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1c7wlch1v6oos31410mw60y3qzn3].[none:Calculation_2171313636048905:nk]'>
            <groupfilter function='member' level='[none:Calculation_2171313636048905:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
