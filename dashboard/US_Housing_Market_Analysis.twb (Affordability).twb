    <worksheet name='Growth vs Affordability'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Market Growth vs. Affordability</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Comparing 2024 market momentum with home price-to-income ratios across U.S. metros</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro_Crosswalk' name='federated.1c7wlch1v6oos31410mw60y3qzn3' />
