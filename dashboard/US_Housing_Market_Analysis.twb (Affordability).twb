          <formatted-text>
            <run bold='true' fontsize='12'>Mortgage P&amp;I % of Income</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro_Crosswalk' name='federated.1c7wlch1v6oos31410mw60y3qzn3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metro Area' datatype='string' name='[Parameter 2171313635725320]' param-domain-type='list' role='measure' type='nominal' value='&quot;York, PA&quot;'>
              <calculation class='tableau' formula='&quot;York, PA&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c7wlch1v6oos31410mw60y3qzn3'>
            <column aggregation='Avg' caption='2024 Home Value' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_2171313628524544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Date]) = 2024&#13;&#10;AND MONTH([Date]) = 12&#13;&#10;THEN [Home Value]&#13;&#10;END' />
            </column>
            <column caption='Estimated Mortgage P&amp;I' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2171313631449092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2171313628524544] * 0.80) *&#13;&#10;((6.724 / 100 / 12) * POWER(1 + (6.724 / 100 / 12), 360))&#13;&#10;/&#13;&#10;(POWER(1 + (6.724 / 100 / 12), 360) - 1)' />
            </column>
            <column caption='Mortgage Payment % of Income' datatype='real' default-format='p0.0%' name='[Calculation_2171313631879173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2171313631449092] * 12)&#13;&#10;/&#13;&#10;[Median Household Income]' />
            </column>
            <column caption='Metro Parameter Filter' datatype='boolean' name='[Calculation_2171313636048905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Zillow Metro] = [Parameters].[Parameter 2171313635725320]' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Home Value]' role='measure' type='quantitative' />
            <column aggregation='Avg' datatype='integer' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Median Household Income]' role='measure' type='quantitative' />
            <column datatype='string' name='[Zillow Metro]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2171313636048905]' derivation='None' name='[none:Calculation_2171313636048905:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2171313631879173]' derivation='Sum' name='[sum:Calculation_2171313631879173:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1c7wlch1v6oos31410mw60y3qzn3].[none:Calculation_2171313636048905:nk]'>
            <groupfilter function='member' level='[none:Calculation_2171313636048905:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1c7wlch1v6oos31410mw60y3qzn3].[none:Calculation_2171313636048905:nk]</column>
          </slices>
