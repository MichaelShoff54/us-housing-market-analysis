          <datasource-dependencies datasource='federated.1c7wlch1v6oos31410mw60y3qzn3'>
            <column aggregation='Avg' caption='2024 Home Value' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_2171313628524544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Date]) = 2024&#13;&#10;AND MONTH([Date]) = 12&#13;&#10;THEN [Home Value]&#13;&#10;END' />
            </column>
            <column caption='Price-to-Income Ratio' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2171313628827649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_2171313628524544]) / AVG([Median Household Income])' />
            </column>
            <column caption='Estimated Mortgage P&amp;I' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2171313631449092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2171313628524544] * 0.80) *&#13;&#10;((6.724 / 100 / 12) * POWER(1 + (6.724 / 100 / 12), 360))&#13;&#10;/&#13;&#10;(POWER(1 + (6.724 / 100 / 12), 360) - 1)' />
            </column>
            <column caption='Mortgage Payment % of Income' datatype='real' default-format='p0.0%' name='[Calculation_2171313631879173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2171313631449092] * 12)&#13;&#10;/&#13;&#10;[Median Household Income]' />
            </column>
            <column caption='Monthly Rent' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2171313632522246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Date (ZORI!Clean)]) = 2024&#13;&#10;AND MONTH([Date (ZORI!Clean)]) = 12&#13;&#10;THEN [Rent]&#13;&#10;END' />
            </column>
            <column caption='Rent % of Income' datatype='real' default-format='p0.0%' name='[Calculation_2171313632759815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([Calculation_2171313632522246]) * 12)&#13;&#10;/&#13;&#10;AVG([Median Household Income])' />
            </column>
