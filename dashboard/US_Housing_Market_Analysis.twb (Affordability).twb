          <datasource-dependencies datasource='federated.1c7wlch1v6oos31410mw60y3qzn3'>
            <column aggregation='Avg' caption='2024 Home Value' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_2171313628524544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Date]) = 2024&#13;&#10;AND MONTH([Date]) = 12&#13;&#10;THEN [Home Value]&#13;&#10;END' />
            </column>
            <column caption='Price-to-Income Ratio' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2171313628827649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_2171313628524544]) / AVG([Median Household Income])' />
            </column>
            <column caption='2024 Home Value Growth' datatype='real' default-format='p0.0%' name='[Calculation_2171313648156682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date]) = 2024&#13;&#10;        AND MONTH([Date]) = 12&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date]) = 2023&#13;&#10;        AND MONTH([Date]) = 12&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;) - 1' />
            </column>
            <column caption='2024 Rent Growth' datatype='real' default-format='p0.0%' name='[Calculation_2171313648758795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date (ZORI!Clean)]) = 2024&#13;&#10;        AND MONTH([Date (ZORI!Clean)]) = 12&#13;&#10;        THEN [Rent]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    AVG(&#13;&#10;        IF YEAR([Date (ZORI!Clean)]) = 2023&#13;&#10;        AND MONTH([Date (ZORI!Clean)]) = 12&#13;&#10;        THEN [Rent]&#13;&#10;        END&#13;&#10;    )&#13;&#10;) - 1' />
            </column>
            <column caption='Investment Growth Score' datatype='real' default-format='p0.0%' name='[Calculation_2171313651093517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2171313648156682] + [Calculation_2171313648758795]) / 2' />
            </column>
            <column caption='Rent Date' datatype='date' name='[Date (ZORI!Clean)]' role='dimension' type='ordinal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Home Value]' role='measure' type='quantitative' />
            <column aggregation='Avg' datatype='integer' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Median Household Income]' role='measure' type='quantitative' />
            <column datatype='real' name='[Rent]' role='measure' type='quantitative' />
            <column datatype='string' name='[Zillow Metro]' role='dimension' type='nominal' />
            <column-instance column='[Zillow Metro]' derivation='None' name='[none:Zillow Metro:nk]' pivot='key' type='nominal' />
