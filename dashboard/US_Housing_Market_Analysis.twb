              <calculation class='tableau' formula='[RegionName] = [Parameters].[Parameter 0774383769235460]' />
            </column>
            <column caption='Latest Home Value YoY KPI' datatype='real' default-format='p0.0%' name='[Calculation_0774383775662092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    SUM(&#13;&#10;        IF [Date] = { FIXED : MAX([Date]) }&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    SUM(&#13;&#10;        IF [Date] = DATEADD(&apos;year&apos;, -1, { FIXED : MAX([Date]) })&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;) - 1' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Home Value]' role='measure' type='quantitative' />
            <column caption='Region Name' datatype='string' name='[RegionName]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0774383769710597]' derivation='None' name='[none:Calculation_0774383769710597:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0774383775662092]' derivation='User' name='[usr:Calculation_0774383775662092:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
