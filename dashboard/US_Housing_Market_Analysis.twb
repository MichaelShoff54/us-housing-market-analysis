      </column>
      <column caption='Latest Home Value' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_0774383772958728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date] = { FIXED : MAX([Date]) }&#13;&#10;THEN [Home Value]&#13;&#10;END' />
      </column>
      <column caption='Latest Home Value YoY%' datatype='real' default-format='p0.0%' name='[Calculation_0774383773646857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN&#13;&#10;    (AVG([Home Value]) / LOOKUP(AVG([Home Value]), -12)) - 1&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest Month Filter' datatype='boolean' name='[Calculation_0774383774322698]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-field='[federated.0yulp7e1x2gkcm14c0a6p10dwu18].[Date]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Show Latest Month' datatype='boolean' name='[Calculation_0774383775436811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Date] = { FIXED : MAX([Date]) }' />
      </column>
      <column caption='Latest Home Value YoY KPI' datatype='real' default-format='p0.0%' name='[Calculation_0774383775662092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(&#13;&#10;        IF [Date] = { FIXED : MAX([Date]) }&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    SUM(&#13;&#10;        IF [Date] = DATEADD(&apos;year&apos;, -1, { FIXED : MAX([Date]) })&#13;&#10;        THEN [Home Value]&#13;&#10;        END&#13;&#10;    )&#13;&#10;) - 1' />
      </column>
