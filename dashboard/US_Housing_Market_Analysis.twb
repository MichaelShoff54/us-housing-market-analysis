      <column caption='Home Value YoY%' datatype='real' default-format='p0.0%' name='[Calculation_0774383759503360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Home Value]) / LOOKUP(AVG([Home Value]), -12)) - 1'>
          <table-calc ordering-field='[federated.0yulp7e1x2gkcm14c0a6p10dwu18].[Date]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Metro Parameter Filter' datatype='boolean' name='[Calculation_0774383769710597]' role='dimension' type='nominal'>
