            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metro Area' datatype='string' name='[Parameter 0774383769235460]' param-domain-type='list' role='measure' type='nominal' value='&quot;York, PA&quot;'>
              <calculation class='tableau' formula='&quot;York, PA&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0yulp7e1x2gkcm14c0a6p10dwu18'>
